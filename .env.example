# 复制本文件为 .env 并填入真实值。.env 已被 gitignore，请勿提交。
# 除 OPENAI_API_KEY 外，其余均可省略（使用默认值）。

# ===== DeepSeek / OpenAI 兼容接口 =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ===== 行为开关 =====
# DRY_RUN=true 时不调用 AI，回复用占位文本（调试用）
DRY_RUN=false
# 发送回复前自动把微信切到最前面
AUTO_ACTIVATE_WECHAT=true
# 「请喝杯咖啡」付款码展示：GUI 右上角常驻缩略图（点击开原图）；
# 命令行模式在启动/退出时打印文案并打开 img/ 下的付款码原图
# false=GUI 不显示付款码栏，命令行也完全静默
SHOW_DONATE=true
# 回复时是否把该联系人长期记忆注入上下文（让 AI 能"回忆"）
MEMORY_INJECT_REPLY=true

# ===== 上下文与记忆调参 =====
CONTEXT_BASE_COUNT=4
CONTEXT_MAX_COUNT=16
CONTEXT_TOKEN_BUDGET=600
MEMORY_ANALYZE_HOURS=24
MEMORY_ANALYZE_INTERVAL_HOURS=6
MEMORY_MAX_CHARS=400

# ===== 表情包功能 =====
# 是否启用表情包回复（AI 自主决定在合适时机返回 [表情:情绪] 标记）
ENABLE_STICKERS=true
# 视觉模型（用于理解对方发来的表情包/图片；DeepSeek 无视觉能力，需另配。
# 例：智谱 GLM-4V / 阿里 Qwen-VL / OpenAI GPT-4o 等 OpenAI 兼容服务）
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# ===== 平台相关 =====
# macOS 微信 Bundle ID
WECHAT_BUNDLE_ID=com.tencent.xinWeChat
# Windows 微信窗口标题（用于定位窗口）
WECHAT_WINDOW_TITLE=微信
